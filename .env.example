# ============================================================
#  RépétIA — Exemple de configuration
#  Copier vers backend/.env  :  cp .env.example backend/.env
#  Puis renseigner LLM_API_KEY. NE JAMAIS COMMITTER backend/.env
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- IA (Google Gemini) ---
# Clé gratuite : https://aistudio.google.com/app/apikey
# ⚠️ Cette clé reste EXCLUSIVEMENT côté serveur. Elle n'est jamais
#    envoyée au navigateur et n'apparaît dans aucun bundle frontend.
LLM_API_KEY=ta_cle_api_gemini_ici

# Modèle principal, puis modèle de repli.
# Le quota gratuit se compte PAR MODÈLE et PAR JOUR : quand le principal est
# épuisé, le service bascule automatiquement sur le second avant de servir la
# banque d'exercices locale.
LLM_MODEL=gemini-3.5-flash
LLM_MODEL_SECOURS=gemini-flash-lite-latest

# --- Base de données (Prisma) ---
# Développement : SQLite (aucune installation requise)
DATABASE_URL="file:./dev.db"

# Production : PostgreSQL — commenter la ligne ci-dessus, décommenter celle-ci
# et passer provider = "postgresql" dans backend/prisma/schema.prisma
# DATABASE_URL="postgresql://user:password@host:5432/repetia?schema=public"

# --- CORS ---
# Origines autorisées, séparées par des virgules. Vide = tout autoriser (dev).
# En production : CORS_ORIGIN=https://repetia.vercel.app
CORS_ORIGIN=

# ============================================================
#  Frontend — à placer dans frontend/.env
# ============================================================
# VITE_API_URL=http://localhost:3000/api
