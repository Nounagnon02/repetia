# RépétIA Mobile — configuration
#
# En développement, l'URL de l'API est déduite automatiquement de l'hôte Metro
# (l'IP LAN de ta machine) : tu n'as normalement RIEN à définir ici.
#
# Renseigne ces variables seulement pour :
#   - viser un backend déployé,
#   - utiliser `npx expo start --tunnel`,
#   - ou surcharger le port du backend local.

# URL complète de l'API (prioritaire sur la détection automatique)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.12:3000/api

# Port du backend local, si différent de 3000
# EXPO_PUBLIC_API_PORT=3000
