generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Développement : "sqlite". Production : passer à "postgresql"
  // puis définir DATABASE_URL (voir README, section « SQLite → PostgreSQL »).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nom       String?
  niveau    String   @default("BEPC")
  serie     String?
  createdAt DateTime @default(now())

  tentatives   Tentative[]
  progressions Progression[]
}

model Matiere {
  id      String  @id @default(uuid())
  code    String  @unique
  libelle String
  niveau  String
  // Ordre d'affichage : les mathématiques d'abord, matière historique du produit.
  ordre   Int     @default(0)
  themes  Theme[]
}

model Theme {
  id        String  @id @default(uuid())
  matiereId String
  libelle   String
  ordre     Int

  matiere      Matiere       @relation(fields: [matiereId], references: [id])
  exercices    Exercice[]
  progressions Progression[]

  @@unique([matiereId, libelle])
}

model Exercice {
  id          String   @id @default(uuid())
  themeId     String
  difficulte  String // "facile", "moyen", "examen"
  enonce      String
  solution    String
  explication String
  source      String // "ia_genere", "banque"
  createdAt   DateTime @default(now())

  theme      Theme       @relation(fields: [themeId], references: [id])
  tentatives Tentative[]
}

model Tentative {
  id           String   @id @default(uuid())
  userId       String
  exerciceId   String
  reponseEleve String
  correct      Boolean
  verdict      String
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  exercice Exercice @relation(fields: [exerciceId], references: [id])
}

model Progression {
  id               String   @id @default(uuid())
  userId           String
  themeId          String
  nbTentatives     Int      @default(0)
  nbReussies       Int      @default(0)
  scoreMaitrise    Int      @default(0) // 0-100
  derniereActivite DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  theme Theme @relation(fields: [themeId], references: [id])

  @@unique([userId, themeId])
}

/// Mode ombre (phase 5 du plan d'entraînement) : réponse du modèle affiné
/// RépétIA, obtenue en parallèle et JAMAIS montrée à l'élève, rangée à côté
/// de celle servie. Aucun identifiant d'élève n'est conservé.
model ComparaisonOmbre {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  tache           String // "generation", "correction"
  matiere         String
  niveau          String
  theme           String?
  difficulte      String?
  entree          String // JSON : énoncé, solution, réponse de l'élève (correction)
  reference       String // JSON de la réponse servie à l'élève
  referenceSource String // "ia_genere", "banque", "repli"
  // Demande exacte envoyée (ou à rejouer, en mode journal) au modèle affiné.
  systeme         String?
  consigne        String?
  temperature     Float?
  candidat        String? // texte brut du modèle affiné ; vide en mode journal
  candidatValide  Boolean  @default(false) // JSON conforme au schéma de la tâche
  dureeMs         Int? // vide en mode journal : la latence n'y est pas mesurée
  erreur          String?
  modele          String
}
