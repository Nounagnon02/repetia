generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Développement : "sqlite". Production : passer à "postgresql"
  // puis définir DATABASE_URL (voir README, section « SQLite → PostgreSQL »).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nom       String?
  niveau    String   @default("BEPC")
  serie     String?
  createdAt DateTime @default(now())

  tentatives   Tentative[]
  progressions Progression[]
}

model Matiere {
  id      String  @id @default(uuid())
  code    String  @unique
  libelle String
  niveau  String
  themes  Theme[]
}

model Theme {
  id        String  @id @default(uuid())
  matiereId String
  libelle   String
  ordre     Int

  matiere      Matiere       @relation(fields: [matiereId], references: [id])
  exercices    Exercice[]
  progressions Progression[]

  @@unique([matiereId, libelle])
}

model Exercice {
  id          String   @id @default(uuid())
  themeId     String
  difficulte  String // "facile", "moyen", "examen"
  enonce      String
  solution    String
  explication String
  source      String // "ia_genere", "banque"
  createdAt   DateTime @default(now())

  theme      Theme       @relation(fields: [themeId], references: [id])
  tentatives Tentative[]
}

model Tentative {
  id           String   @id @default(uuid())
  userId       String
  exerciceId   String
  reponseEleve String
  correct      Boolean
  verdict      String
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  exercice Exercice @relation(fields: [exerciceId], references: [id])
}

model Progression {
  id               String   @id @default(uuid())
  userId           String
  themeId          String
  nbTentatives     Int      @default(0)
  nbReussies       Int      @default(0)
  scoreMaitrise    Int      @default(0) // 0-100
  derniereActivite DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  theme Theme @relation(fields: [themeId], references: [id])

  @@unique([userId, themeId])
}
